# Generated by edaforge.verification.synthesis from seed.json.
read_liberty -lib @LIBERTY@
read_verilog  "rtl/sha256.v" "rtl/sha256_w_mem.v" "rtl/sha256_k_constants.v"

hierarchy -check -top sha256
synth -top sha256 -flatten -noabc
tee -q -o @PRE_STAT_JSON@ stat -json -top sha256
dfflibmap -liberty @LIBERTY@
abc -liberty @LIBERTY@
clean -purge
check -mapped -assert
tee -q -o @STAT_JSON@ stat -json -liberty @LIBERTY@ -top sha256
write_verilog -noattr -noexpr @NETLIST_V@
write_json @NETLIST_JSON@
